# OpenAI
OPENAI_API_KEY=sk-...
# Modelo usado para extrair os clientes do relatório (opcional)
OPENAI_MODEL=gpt-4o

# Trello — gere em https://trello.com/app-key
TRELLO_API_KEY=sua_api_key_do_trello
TRELLO_TOKEN=seu_token_do_trello
# Área de trabalho onde o quadro será criado (deixe vazio para quadros pessoais)
TRELLO_WORKSPACE=THE SMART - 2026

# Porta da interface web (opcional, padrão 3000)
PORT=3000

# --- Webhook do Trello + notificação no WhatsApp (só para o servidor de webhook) ---
# Secret da API do Trello (mesma página da API key) — valida a assinatura do webhook
TRELLO_API_SECRET=seu_secret_do_trello
# URL pública COMPLETA do endpoint (onde o servidor está hospedado)
WEBHOOK_CALLBACK_URL=https://seu-host.exemplo.com/webhook/trello
# Lista(s) que disparam o envio ao cliente (separadas por vírgula)
LISTAS_NOTIFICAR=Enviar msg Ass 24h e Aplicativo da seguradora
# Mensagem enviada ao cliente (opcional; use {nome}). Vazio = usa o padrão do código
MENSAGEM_CLIENTE=
# Porta do servidor de webhook (opcional, padrão 3001)
WEBHOOK_PORT=3001
